#!/usr/bin/env bash
# htmlshare: publish HTML to share.rlew.io through its upload API.
#
#   htmlshare <file|dir> [slug] [--secured] [--pw X | --new-pw] [--gate G] [--listed|--unlisted] [--title T] [--force]
#   htmlshare ls [--public|--secured|--gate G]
#   htmlshare rm <slug> [--secured|--gate G]
#
# Needs bash and curl. Reads HTMLSHARE_URL (default https://share.rlew.io) and
# HTMLSHARE_TOKEN, or the token from ~/.config/htmlshare/token.

set -euo pipefail

BASE_URL="${HTMLSHARE_URL:-https://share.rlew.io}"
BASE_URL="${BASE_URL%/}"
TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/htmlshare/token"

usage() {
	cat <<-EOF
		htmlshare: publish HTML to share.rlew.io

		Usage:
		  htmlshare <file.html|dir> [<slug>] [options]
		  htmlshare ls [--public|--secured|--gate <name>]
		  htmlshare rm <slug> [--secured|--gate <name>]

		Upload options:
		  --secured           Protect with a password (generated by the server)
		  --pw <password>     Use this password (implies --secured)
		  --new-pw            Replace the password of an existing secured artifact with
		                      a generated one (implies --secured)
		  --gate <name>       Gated by the IP ranges of a gate the server has configured;
		                      slug may contain "/"
		  --listed            Show it in the generated index
		  --unlisted          Hide it from the index
		  --title <title>     Title for the index ("" clears it)
		  --force             Replace an existing artifact with the same slug
		  --name, --slug <s>  Same as the second positional argument
		  -h, --help          Show this help

		A replace (--force) keeps the old password, title and listed setting unless
		you give --pw, --new-pw, --title, --listed or --unlisted. A new artifact is
		unlisted, has no title, and a secured one gets a generated password.

		A directory is uploaded as a whole tree and must contain index.html.
		Dotfiles are skipped; symlinks are followed. Without a slug, a random one is used.

		Environment:
		  HTMLSHARE_URL       Server (default https://share.rlew.io)
		  HTMLSHARE_TOKEN     Upload token (else read from $TOKEN_FILE)
	EOF
}

die() { echo "htmlshare: $*" >&2; exit 1; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

load_token() {
	if [ -n "${HTMLSHARE_TOKEN:-}" ]; then
		TOKEN="$HTMLSHARE_TOKEN"
	elif [ -r "$TOKEN_FILE" ]; then
		TOKEN="$(tr -d '[:space:]' <"$TOKEN_FILE")"
	else
		die "no token: set HTMLSHARE_TOKEN or write it to $TOKEN_FILE"
	fi
	[ -n "$TOKEN" ] || die "token is empty"
	case "$TOKEN" in *$'\n'* | *$'\r'*) die "token contains a line break" ;; esac
}

# Escapes a value for a curl config file string. Callers reject line breaks.
config_quote() {
	local v="${1//\\/\\\\}"
	printf '"%s"' "${v//\"/\\\"}"
}

# api METHOD PATH [curl args...]: sets STATUS and BODY. The token, and the
# password if any, go to curl as a config on stdin, so they stay out of ps
# and are never written to disk.
api() {
	local method="$1" path="$2"
	shift 2
	STATUS="$(
		{
			printf 'header = %s\n' "$(config_quote "Authorization: Bearer $TOKEN")"
			if [ -n "${PASSWORD_HEADER:-}" ]; then
				printf 'header = %s\n' "$(config_quote "X-Share-Password: $PASSWORD_HEADER")"
			fi
		} | curl -sS -K - -X "$method" -o "$TMP/body" -w '%{http_code}' "$@" "$BASE_URL/api$path"
	)" || die "could not reach $BASE_URL"
	BODY="$(cat "$TMP/body")"
}

# Reads a string field from flat JSON, undoing \" and \\ escapes.
json_field() {
	printf '%s' "$BODY" | sed -nE "s/.*\"$1\":\"((\\\\.|[^\"\\\\])*)\".*/\\1/p" | sed -E 's/\\(["\\/])/\1/g'
}

fail_with_body() {
	local msg
	msg="$(json_field error)"
	die "${1}: ${msg:-HTTP $STATUS}"
}

# Percent-encodes every byte, which is valid for any query value.
urlencode() {
	local hex out=""
	for hex in $(printf '%s' "$1" | od -An -v -tx1); do out+="%$hex"; done
	printf '%s' "$out"
}

clipboard() {
	[ -z "${HTMLSHARE_NO_CLIPBOARD:-}" ] || return 0
	if command -v pbcopy >/dev/null 2>&1; then
		printf '%s' "$1" | pbcopy && echo "(URL copied to clipboard)"
	elif command -v wl-copy >/dev/null 2>&1; then
		printf '%s' "$1" | wl-copy && echo "(URL copied to clipboard)"
	elif command -v xclip >/dev/null 2>&1; then
		printf '%s' "$1" | xclip -selection clipboard && echo "(URL copied to clipboard)"
	fi
	return 0
}

random_slug() {
	if command -v openssl >/dev/null 2>&1; then
		openssl rand -hex 4
	else
		od -An -N4 -tx1 /dev/urandom | tr -d ' \n'
	fi
}

check_slug() {
	# Spelled out: [a-z] can match capitals in some locales.
	case "$1" in
		'' | *[!abcdefghijklmnopqrstuvwxyz0123456789/-]*) die "slug must be lowercase letters, digits, hyphens (and \"/\" for --gate)" ;;
	esac
}

check_gate() {
	case "$1" in
		# Spelled out: [a-z] can match capitals in some locales.
		'' | *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) die "gate name must be lowercase letters, digits and hyphens" ;;
		public | secured) die "\"$1\" is not a gate name; use --$1 or leave it out" ;;
	esac
}

cmd_ls() {
	local query=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--public) query="?visibility=public" ;;
			--secured) query="?visibility=secured" ;;
			--gate) [ $# -ge 2 ] || die "--gate needs a value"; check_gate "$2"; query="?visibility=$2"; shift ;;
			-h | --help) usage; exit 0 ;;
			*) die "unexpected argument: $1" ;;
		esac
		shift
	done
	load_token
	api GET "/artifacts$query"
	[ "$STATUS" = 200 ] || fail_with_body "list failed"
	if command -v jq >/dev/null 2>&1; then
		printf '%s' "$BODY" | jq -r '.artifacts[] | [.url, .updated[0:10], (if .listed then "listed" else "-" end), (.title // "")] | @tsv'
	else
		printf '%s' "$BODY" | grep -oE '"url":"[^"]*"' | sed -E 's/^"url":"(.*)"$/\1/'
	fi
}

cmd_rm() {
	local slug="" scope=public
	while [ $# -gt 0 ]; do
		case "$1" in
			--secured) scope=secured ;;
			--gate) [ $# -ge 2 ] || die "--gate needs a value"; check_gate "$2"; scope="$2"; shift ;;
			-h | --help) usage; exit 0 ;;
			-*) die "unknown option: $1" ;;
			*) [ -z "$slug" ] || die "unexpected argument: $1"; slug="$1" ;;
		esac
		shift
	done
	[ -n "$slug" ] || die "usage: htmlshare rm <slug> [--secured|--gate <name>]"
	check_slug "$slug"
	load_token
	api DELETE "/artifacts/$scope/$slug"
	[ "$STATUS" = 200 ] || fail_with_body "delete failed"
	echo "Deleted: $(json_field url)"
}

cmd_upload() {
	local src="" slug="" scope=public secured=0 gate="" password="" have_pw=0
	local listed="" title="" have_title=0 force=0 newpw=0
	while [ $# -gt 0 ]; do
		case "$1" in
			-h | --help) usage; exit 0 ;;
			--secured) secured=1; shift ;;
			--pw) [ $# -ge 2 ] || die "--pw needs a value"; secured=1; have_pw=1; password="$2"; shift 2 ;;
			--gate) [ $# -ge 2 ] || die "--gate needs a value"; check_gate "$2"; gate="$2"; shift 2 ;;
			--new-pw) secured=1; newpw=1; shift ;;
			--listed) listed=true; shift ;;
			--unlisted) listed=false; shift ;;
			--title) [ $# -ge 2 ] || die "--title needs a value"; have_title=1; title="$2"; shift 2 ;;
			--force) force=1; shift ;;
			--name | --slug) [ $# -ge 2 ] || die "$1 needs a value"; slug="$2"; shift 2 ;;
			--) shift; break ;;
			-*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
			*)
				if [ -z "$src" ]; then src="$1"
				elif [ -z "$slug" ]; then slug="$1"
				else die "unexpected argument: $1"; fi
				shift ;;
		esac
	done
	[ -n "$src" ] || { usage >&2; exit 2; }
	[ -e "$src" ] || die "not found: $src"
	[ "$secured" = 1 ] && [ -n "$gate" ] && die "--secured and --gate cannot be combined"
	[ "$have_pw" = 1 ] && [ -z "$password" ] && die "--pw is empty"
	[ "$have_pw" = 1 ] && [ "$newpw" = 1 ] && die "--pw and --new-pw cannot be combined"
	case "$password" in *$'\n'* | *$'\r'*) die "--pw contains a line break" ;; esac
	[ "$secured" = 1 ] && scope=secured
	[ -n "$gate" ] && scope="$gate"
	[ -n "$slug" ] || slug="$(random_slug)"
	check_slug "$slug"

	local -a body
	if [ -d "$src" ]; then
		[ "$src" = / ] || src="${src%/}"
		[ -f "$src/index.html" ] || die "$src has no index.html"
		local rel count=0
		body=()
		while IFS= read -r -d '' rel; do
			rel="${rel#./}"
			case "$src/$rel" in
				*'"'* | *\\* | *'='* | *';'* | *','* | *$'\n'*)
					die "cannot upload a path containing a quote, backslash, =, ; , or newline: $rel" ;;
			esac
			body+=(-F "$rel=@\"$src/$rel\"")
			count=$((count + 1))
		done < <(cd "$src" && find -L . -type f ! -path '*/.*' -print0)
		echo "Uploading $count files from $src"
	elif [ -f "$src" ]; then
		body=(-H 'Content-Type: text/html' --data-binary "@$src")
	else
		die "not a file or directory: $src"
	fi

	# Only settings the user gave are sent; the server keeps the rest on a replace.
	local -a params=()
	[ -n "$listed" ] && params+=("listed=$listed")
	[ "$have_title" = 1 ] && params+=("title=$(urlencode "$title")")
	[ "$newpw" = 1 ] && params+=("regenerate=true")
	[ "$force" = 1 ] && params+=("overwrite=true")
	local query="" param
	for param in ${params[@]+"${params[@]}"}; do query+="${query:+&}$param"; done

	# The server refuses to replace an existing artifact unless overwrite=true is sent.
	load_token
	[ "$have_pw" = 1 ] && PASSWORD_HEADER="$password"
	api PUT "/artifacts/$scope/$slug${query:+?$query}" "${body[@]}"
	PASSWORD_HEADER=""
	case "$STATUS" in
		200 | 201) ;;
		409)
			case "$(json_field error)" in
				*'already exists'*) die "$scope slug \"$slug\" already exists (use --force to replace it)" ;;
			esac
			fail_with_body "upload failed" ;;
		*) fail_with_body "upload failed" ;;
	esac

	local url
	url="$(json_field url)"
	if [ "$scope" = secured ]; then
		echo "URL:      $url"
		if [ "$have_pw" = 1 ]; then
			echo "Password: $password"
		elif [ "$(printf '%s' "$BODY" | sed -nE 's/.*"passwordUnchanged": *(true).*/\1/p')" = true ]; then
			echo "Password: unchanged"
		else
			echo "Password: $(json_field password)"
		fi
	else
		echo "URL: $url"
	fi
	clipboard "$url"
}

case "${1:-}" in
	ls) shift; cmd_ls "$@" ;;
	rm) shift; cmd_rm "$@" ;;
	*) cmd_upload "$@" ;;
esac
